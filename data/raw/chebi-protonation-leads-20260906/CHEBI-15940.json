le":false,"chebi_accession":"CHEBI:50247","name":"antidote","definition":"Any protective agent counteracting or neutralizing the action of poisons.","id":50247,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:75835","name":"anti-anaemic agent","definition":"A compound which increases either the number of red cells or the amount of haemoglobin in the blood.","id":75835,"biological_role":false},{"application":false,"chemical_role":false,"chebi_accession":"CHEBI:64946","name":"anti-HIV agent","definition":"An antiviral agent that destroys or inhibits the replication of the human immunodeficiency virus.","id":64946,"biological_role":true},{"application":false,"chemical_role":false,"chebi_accession":"CHEBI:76924","name":"plant metabolite","definition":"Any eukaryotic metabolite produced during a metabolic reaction in plants, the kingdom that include flowering plants, conifers and other gymnosperms.","id":76924,"biological_role":true},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:35679","name":"antilipemic drug","definition":"A substance used to treat hyperlipidemia (an excess of lipids in the blood).","id":35679,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:145947","name":"antiatherosclerotic agent","definition":"A cardiovascular drug that prevents atherosclerosis (a disease in which the inside of an artery narrows due to the build up of plaque). Compare with <a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:50855\" target=\"_blank\">antiatherogenic agent</a>.","id":145947,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:35554","name":"cardiovascular drug","definition":"A drug that affects the rate or intensity of cardiac contraction, blood vessel diameter or blood volume.","id":35554,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:35474","name":"anxiolytic drug","definition":"Anxiolytic drugs are agents that alleviate anxiety, tension, and anxiety disorders, promote sedation, and have a calming effect without affecting clarity of consciousness or neurologic conditions.","id":35474,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:35821","name":"anticholesteremic drug","definition":"A substance used to lower plasma cholesterol levels.","id":35821,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:33231","name":"antitubercular agent","definition":"A substance that kills or slows the growth of <em>Mycobacterium tuberculosis</em> and is used in the treatment of tuberculosis.","id":33231,"biological_role":true},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:35526","name":"hypoglycemic agent","definition":"A drug which lowers the blood glucose level.","id":35526,"biological_role":false},{"application":false,"chemical_role":false,"chebi_accession":"CHEBI:75771","name":"mouse metabolite","definition":"Any mammalian metabolite produced during a metabolic reaction in a mouse (<em>Mus musculus</em>).","id":75771,"biological_role":true},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:35610","name":"antineoplastic agent","definition":"A substance that inhibits or prevents the proliferation of neoplasms.","id":35610,"biological_role":false},{"application":false,"chemical_role":false,"chebi_accession":"CHEBI:76971","name":"Escherichia coli metabolite","definition":"Any bacterial metabolite produced during a metabolic reaction in <em>Escherichia coli</em>.","id":76971,"biological_role":true},{"application":false,"chemical_role":false,"chebi_accession":"CHEBI:84087","name":"human urinary metabolite","definition":"Any metabolite (endogenous or exogenous) found in human urine samples.","id":84087,"biological_role":true},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:35480","name":"analgesic","definition":"An agent capable of relieving pain without the loss of consciousness or without producing anaesthesia. In addition, analgesic is a role played by a compound which is exhibited by a capability to cause a reduction of pain symptoms.","id":35480,"biological_role":true},{"application":false,"chemical_role":false,"chebi_accession":"CHEBI:84264","name":"EC 3.5.1.19 (nicotinamidase) inhibitor","definition":"An EC 3.5.1.* (non-peptide linear amide C-N hydrolase) inhibitor that interferes with the action of nicotinamidase (EC 3.5.1.19).","id":84264,"biological_role":true},{"application":false,"chemical_role":false,"chebi_accession":"CHEBI:27314","name":"water-soluble vitamin (role)","definition":"Any vitamin that dissolves in water and readily absorbed into tissues for immediate use. Unlike the fat-soluble vitamins, they are not stored in the body and need to be replenished regularly in the diet and will rarely accumulate to toxic levels since they are quickly excreted from the body via urine.","id":27314,"biological_role":true},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:50733","name":"nutraceutical","definition":"A product in capsule, tablet or liquid form that provide essential nutrients, such as a vitamin, an essential mineral, a protein, an herb, or similar nutritional substance.","id":50733,"biological_role":false},{"application":false,"chemical_role":false,"chebi_accession":"CHEBI:25212","name":"metabolite","definition":"Any intermediate or product resulting from metabolism. The term 'metabolite' subsumes the classes commonly known as primary and secondary metabolites.","id":25212,"biological_role":true},{"application":false,"chemical_role":true,"chebi_accession":"CHEBI:39141","name":"Bronsted acid","definition":"A molecular entity capable of donating a hydron to an acceptor (Brønsted base).","id":39141,"biological_role":false}],"is_released":true}
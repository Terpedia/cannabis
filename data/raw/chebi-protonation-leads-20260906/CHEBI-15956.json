5","type":"CAS","source_name":"ChemIDplus","url":"https://bioregistry.io/chemidplus:58-85-5","prefix":"chemidplus"},{"id":91370,"accession_number":"58-85-5","type":"CAS","source_name":"NIST Chemistry WebBook","url":"http://webbook.nist.gov/cgi/cbook.cgi?ID=58-85-5","prefix":"nist"}]},"roles_classification":[{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:231911","name":"renoprotective agent","definition":"Any compound that is able to prevent damage to the kidneys.","id":231911,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:75835","name":"anti-anaemic agent","definition":"A compound which increases either the number of red cells or the amount of haemoglobin in the blood.","id":75835,"biological_role":false},{"application":false,"chemical_role":false,"chebi_accession":"CHEBI:77746","name":"human metabolite","definition":"Any mammalian metabolite  produced during a metabolic reaction in humans (<em>Homo sapiens</em>).","id":77746,"biological_role":true},{"application":false,"chemical_role":false,"chebi_accession":"CHEBI:23354","name":"coenzyme","definition":"A low-molecular-weight, non-protein organic compound participating in enzymatic reactions as dissociable acceptor or donor of chemical groups or electrons.","id":23354,"biological_role":true},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:50733","name":"nutraceutical","definition":"A product in capsule, tablet or liquid form that provide essential nutrients, such as a vitamin, an essential mineral, a protein, an herb, or similar nutritional substance.","id":50733,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:35526","name":"hypoglycemic agent","definition":"A drug which lowers the blood glucose level.","id":35526,"biological_role":false},{"application":false,"chemical_role":false,"chebi_accession":"CHEBI:75771","name":"mouse metabolite","definition":"Any mammalian metabolite produced during a metabolic reaction in a mouse (<em>Mus musculus</em>).","id":75771,"biological_role":true},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:35554","name":"cardiovascular drug","definition":"A drug that affects the rate or intensity of cardiac contraction, blood vessel diameter or blood volume.","id":35554,"biological_role":false},{"application":false,"chemical_role":false,"chebi_accession":"CHEBI:23357","name":"cofactor","definition":"An organic molecule or ion (usually a metal ion) that is required by an enzyme for its activity. It may be attached either loosely (coenzyme) or tightly (prosthetic group).","id":23357,"biological_role":true},{"application":false,"chemical_role":false,"chebi_accession":"CHEBI:75772","name":"Saccharomyces cerevisiae metabolite","definition":"Any  fungal metabolite produced during a metabolic reaction in Baker's yeast (<em>Saccharomyces cerevisiae </em>).","id":75772,"biological_role":true},{"application":false,"chemical_role":false,"chebi_accession":"CHEBI:76971","name":"Escherichia coli metabolite","definition":"Any bacterial metabolite produced during a metabolic reaction in <em>Escherichia coli</em>.","id":76971,"biological_role":true},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:35705","name":"immunosuppressive agent","definition":"An agent that suppresses immune function by one of several mechanisms of action. Classical cytotoxic immunosuppressants act by inhibiting DNA synthesis. Others may act through activation of T-cells or by inhibiting the activation of helper cells. In addition, an immunosuppressive agent is a role played by a compound which is exhibited by a capability to diminish the extent and/or voracity of an immune response.","id":35705,"biological_role":true},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:65023","name":"anti-asthmatic agent","definition":"Any compound that has anti-asthmatic effects.","id":65023,"biological_role":false},{"application":false,"chemical_role":false,"chebi_accession":"CHEBI:26348","name":"prosthetic group","definition":"A tightly bound, specific nonpolypeptide unit in a protein determining and involved in its biological activity.","id":26348,"biological_role":true},{"application":false,"chemical_role":false,"chebi_accession":"CHEBI:78675","name":"fundamental metabolite","definition":"Any metabolite produced by all living cells.","id":78675,"biological_role":true},{"application":false,"chemical_role":false,"chebi_accession":"CHEBI:27314","name":"water-soluble vitamin (role)","definition":"Any vitamin that dissolves in water and readily absorbed into tissues for immediate use. Unlike the fat-soluble vitamins, they are not stored in the body and need to be replenished regularly in the diet and will rarely accumulate to toxic levels since they are quickly excreted from the body via urine.","id":27314,"biological_role":true},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:50733","name":"nutraceutical","definition":"A product in capsule, tablet or liquid form that provide essential nutrients, such as a vitamin, an essential mineral, a protein, an herb, or similar nutritional substance.","id":50733,"biological_role":false},{"application":false,"chemical_role":true,"chebi_accession":"CHEBI:39141","name":"Bronsted acid","definition":"A molecular entity capable of donating a hydron to an acceptor (Brønsted base).","id":39141,"biological_role":false}],"is_released":true}